# ============================================================
# Prediction Market Trading Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#   # Edit .env with your keys
#   export $(cat .env | xargs)  # or use python-dotenv
# ============================================================

# ----------------------------------------------------------------
# Anthropic / Claude API (Layer 3 AI agent)
# Get your key at: https://console.anthropic.com/
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------
# Polymarket CLOB API (Layers 2 & 3 — order placement)
# Generate at: https://polymarket.com/ (connect wallet → API Keys)
# ----------------------------------------------------------------
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase

# ----------------------------------------------------------------
# Polygon Wallet (required for on-chain order signing)
# ----------------------------------------------------------------
POLYGON_WALLET_PRIVATE_KEY=0x...
POLYGON_WALLET_ADDRESS=0x...

# ----------------------------------------------------------------
# Twitter / X API v2 (Layer 1 news + Layer 4 sentiment)
# Apply at: https://developer.twitter.com/
# Only BEARER_TOKEN is required for read-only stream access.
# ----------------------------------------------------------------
TWITTER_BEARER_TOKEN=AAAA...
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ----------------------------------------------------------------
# Storage paths
# ----------------------------------------------------------------
DB_PATH=data/prediction_markets.db
CSV_DIR=data/csv

# ----------------------------------------------------------------
# Alerts (optional — Layer 5)
# Set ALERT_WEBHOOK_URL to a Slack/Discord incoming webhook URL
# ----------------------------------------------------------------
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=you@example.com
