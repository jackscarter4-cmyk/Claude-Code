# ============================================================
# Offline Stock Quant Engine -- Environment Variables
# ============================================================
# This build is FULLY OFFLINE. There are NO API keys to set.
# These two paths are the only configurable values, and both
# have sensible defaults — you usually don't need a .env at all.
# ============================================================

# Where the local SQLite database lives
DB_PATH=data/trading.db

# Where CSV exports are written
CSV_DIR=data/csv
