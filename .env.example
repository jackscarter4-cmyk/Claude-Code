# ============================================================
# Stock Trading Engine -- Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#   # Edit .env with your keys
#   export $(cat .env | xargs)  # or use python-dotenv
# ============================================================

# ----------------------------------------------------------------
# Anthropic / Claude API (Layer 3 AI agent)
# Get your key at: https://console.anthropic.com/
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------
# Alpaca API (Layers 1, 2, 3 -- market data + order execution)
# Generate at: https://alpaca.markets/ -> Paper Trading -> API Keys
# Use paper URL for testing; switch to live URL for real money.
# ----------------------------------------------------------------
ALPACA_API_KEY=PKxxx
ALPACA_API_SECRET=xxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ----------------------------------------------------------------
# Twitter / X API v2 (Layer 1 news + Layer 4 sentiment)
# Apply at: https://developer.twitter.com/
# Only BEARER_TOKEN is required for read-only stream access.
# ----------------------------------------------------------------
TWITTER_BEARER_TOKEN=AAAA...
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ----------------------------------------------------------------
# Storage paths
# ----------------------------------------------------------------
DB_PATH=data/trading.db
CSV_DIR=data/csv

# ----------------------------------------------------------------
# Alerts (optional -- Layer 5)
# Set ALERT_WEBHOOK_URL to a Slack/Discord incoming webhook URL
# ----------------------------------------------------------------
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=you@example.com
